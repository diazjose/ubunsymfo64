<form
    method="post"
    action="{{ path('app_user_status', { id: user.id }) }}"
    class="d-inline"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    
        {% if user.deletedAt is null %}
        <button class="btn btn-danger">
            <i class="bi bi-person-fill-slash"></i> BLOQUEAR
        </button>
        {% else %}
        <button class="btn btn-success">
            <i class="bi bi-person-fill-check"></i> DESBLOQUEAR
        </button>
        {% endif %}
</form>
