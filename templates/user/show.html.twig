{% extends 'base.html.twig' %}

{% block title %}Detalle del Usuario{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4">Detalle del Usuario</h1>
        <a href="{{ path('app_user') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row mb-0">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">{{ user.id }}</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">{{ user.email }}</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">{{ user.nombre }}</dd>

                <dt class="col-sm-3">Apellido</dt>
                <dd class="col-sm-9">{{ user.apellido }}</dd>
            </dl>

            <div class="mt-4">
                <a href="{{ path('app_user_edit', { id: user.id }) }}" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Editar
                </a>

                {{ include('user/_delete_form.html.twig') }}
            </div>

        </div>
    </div>
</div>
{% endblock %}
