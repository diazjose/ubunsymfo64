<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mi App{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.2/font/bootstrap-icons.css">

    {#<link rel="stylesheet" href="{{ asset('build/app.css') }}">
    {# Estilos de Bootstrap y tus CSS #}
    {{ importmap('app') }}
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- 🔹 Navbar global -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">MiApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Inicio</a>
                    </li>
                    {% set currentRoute = app.request.attributes.get('_route') %}
                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link {{ currentRoute == 'app' ? 'active disabled' : '' }}" href="#">
                                👋 {{ app.user.userIdentifier }}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ currentRoute == 'app_user' ? 'active disabled' : '' }}" href="{{ currentRoute == 'app_user' ? '#' : path('app_user') }}">Usuarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ currentRoute == 'app_logout' ? '#' : path('app_logout') }}">Salir</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">Entrar</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- 🔹 Contenido principal -->
    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>

    <script src="{{ asset('build/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>

